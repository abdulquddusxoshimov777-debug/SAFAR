# Safar App - Environment Variables
# Copy this file to .env and fill in your own values

# Server port (Render.com and Railway set this automatically)
PORT=4000

# JWT secret - use a long random string in production!
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-very-long-random-secret-here-change-this

# Environment
NODE_ENV=production

# Admin email (for admin-only endpoints)
ADMIN_EMAIL=abdulquddusxoshimov777@gmail.com
